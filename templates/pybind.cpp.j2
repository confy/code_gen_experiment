#include <pybind11/pybind11.h>
#include <pybind11/stl.h>
#include <cstring>
#include "{{ group.name_camel }}.h"
#include <json.hpp>
#include <string>

namespace py = pybind11;
using json = nlohmann::json;

void {{ group.binding_func | default('bind_' + group.name_snake) }}(py::module &m) {
    auto cls = py::class_<{{ group.name_camel }}, CalibrationGroup>(m, "{{ group.name_snake }}", R"pbdoc({{ group.doc }})pbdoc");
    cls.def(py::init<>());

    {% for field in group.fields %}
    {% if field.size %}
        cls.def_property("{{ field.name_snake }}",
            [](const {{ group.name_camel }} &self) {
                return std::vector<float>(self.{{ field.name_member }}, self.{{ field.name_member }} + {{ field.size }});
            },
            []({{ group.name_camel }} &self, const std::vector<float> &v) {
                if (v.size() != {{ field.size }}) throw py::value_error("Expected size {{ field.size }}");
                std::memcpy(self.{{ field.name_member }}, v.data(), {{ field.size }} * sizeof(float));
            }, "{{ field.doc }}");
    {% else %}
    cls.def_readwrite("{{ field.name_snake }}", &{{ group.name_camel }}::{{ field.name_member }}, "{{ field.doc }}");
    {% endif %}
    {% endfor %}

    cls.def("to_bytes", [](const {{ group.name_camel }}& self) {
        return py::bytes(reinterpret_cast<const char*>(&self), sizeof({{ group.name_camel }}));
    });

    cls.def_static("from_bytes", [](py::bytes data) {
        std::string s = data;
        if (s.size() != sizeof({{ group.name_camel }})) throw py::value_error("Size mismatch");
        {{ group.name_camel }} obj;
        std::memcpy(&obj, s.data(), sizeof({{ group.name_camel }}));
        return obj;
    });

    cls.def("to_json_string", [](const {{ group.name_camel }}& self) {
        json j = self;
        return j.dump();
    });

    cls.def_static("from_json_string", [](const std::string& json_string) {
        auto j = json::parse(json_string);
        return j.get<{{ group.name_camel }}>();
    });
}